{
  "name": "sirh-police-djiboutienne",
  "version": "1.0.0",
  "description": "Système Intranet Centralisé de Gestion des Ressources Humaines de la Police Djiboutienne",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "test": "node tests/runner.js",
    "test:native": "node --test tests/**/*.test.js",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:boundaries": "node --test tests/boundaries/*.test.js",
    "test:integration": "node --test tests/integration/*.test.js",
    "test:e2e": "node --test tests/e2e/*.test.js",
    "build": "tsc && cp -r src/public dist/",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "db:migrate": "tsx src/database/migrate.ts",
    "db:seed": "tsx src/database/seed.ts",
    "db:reset": "tsx src/database/reset.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^9.4.0",
    "@fastify/cors": "^9.0.1",
    "@fastify/static": "^7.0.4",
    "dotenv": "^16.4.5",
    "fastify": "^4.29.1",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "keywords": [
    "sirh",
    "police",
    "djibouti",
    "tests",
    "e2e",
    "rbac",
    "audit-sha256"
  ],
  "author": "Police Nationale de la République de Djibouti",
  "license": "Propriétaire"
}
